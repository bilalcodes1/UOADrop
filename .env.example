# UOADrop environment variables
# Copy to .env.local (web) or .env (desktop) and fill in real values.
# Never commit real secrets. See docs/SETUP.md for provisioning.

# ─────────────────────────────────────────
# Supabase / Online
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to browser
UOADROP_DESKTOP_ACTIVATION_PASSWORD=
UOADROP_DESKTOP_TOKEN_SECRET=
UOADROP_ENCRYPTION_PRIVATE_KEY_BASE64=
NEXT_PUBLIC_UOADROP_ENCRYPTION_PUBLIC_KEY=

# ─────────────────────────────────────────
# Email notifications / online announcements (SMTP)
# ─────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=UOADrop <no-reply@yourdomain.com>

# ─────────────────────────────────────────
# Telegram bot
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=     # random string, verify header on webhook

# ─────────────────────────────────────────
# Desktop app (librarian laptop)
# ─────────────────────────────────────────
DESKTOP_PORT=3737
DESKTOP_LAN_IP=192.168.50.10
DESKTOP_DB_PATH=./data/uoadrop.db
LIBRARIAN_PIN_HASH=          # bcrypt hash of librarian unlock PIN
UOADROP_WEB_BASE_URL=https://uoadrop.vercel.app

# ─────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
